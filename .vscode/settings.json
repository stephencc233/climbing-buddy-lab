{
  // 工作区设置：覆盖个人的用户设置，随仓库提交，克隆下来即生效

  // 解释器固定为项目的 .venv（由 uv sync 创建）。
  // 只在本工作区还没手动选过解释器时生效；路径是 Windows 写法
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",

  // Python 文件保存时用 Ruff 格式化。
  // 不开保存时自动修复 lint（codeActionsOnSave）：学习阶段先看到问题，再手动修
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },

  // 用 .venv 里由 uv.lock 锁定的 ruff，而不是扩展自带的那份，保证编辑器和命令行结果一致
  "ruff.importStrategy": "fromEnvironment",
  // 规则以 pyproject.toml 为准，个人的 VS Code ruff.* 设置不能覆盖项目配置
  "ruff.configurationPreference": "filesystemFirst",

  // 测试面板（烧杯图标）：用 pytest，关掉 unittest，两个框架同时开会重复发现。
  // 参数留空：收集范围和选项统一由 pyproject.toml 的 [tool.pytest] 决定，面板、终端、任务口径一致
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": []
}
